{
    "name": "@dslab/trino-query-ui",
    "description": "Trino Query Editor react component",
    "version": "0.1.9",
    "author": {
        "name": "Trino contributors",
        "email": "general@trino.io",
        "url": "https://github.com/trinodb/trino-query-ui/graphs/contributors"
    },
    "contributors": [
        {
            "name": "Sanasar Hambardzumyan",
            "email": "shambardzumyan@fbk.eu"
        }
    ],
    "keywords": [
        "trino",
        "trinodb",
        "react"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/scc-digitalhub/trino-query-ui.git"
    },
    "publishConfig": {
        "access": "public",
        "public": true
    },
    "homepage": "https://github.com/trinodb/trino-query-ui",
    "bugs": {
        "url": "https://github.com/trinodb/trino-query-ui/issues"
    },
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "license": "Apache-2.0",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=24"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -p tsconfig.build.json && vite build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "package": "npm install && npm run build",
        "package:clean": "npm clean-install && npm run build",
        "prettier:format": "prettier --write \"./src/**/*.{ts,tsx}\"",
        "prettier:check": "prettier --check \"./src/**/*.{ts,tsx}\"",
        "check": "npm install && npm run lint && npm run prettier:check",
        "check:clean": "npm clean-install && npm run lint && npm run prettier:check",
        "preview": "vite preview",
        "antlr4ng": "antlr4ng -visitor -listener -Dlanguage=TypeScript -o src/generated/lexer/SqlBase.g4 trino/SqlBase.g4"
    },
    "dependencies": {
        "antlr4-c3": "^3.4.4",
        "antlr4ng": "^3.0.16",
        "sql-formatter": "^15.6.9",
        "uuidv4": "^6.2.13"
    },
    "devDependencies": {
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "@typescript-eslint/eslint-plugin": "^8.44.1",
        "@typescript-eslint/parser": "^8.44.1",
        "@vitejs/plugin-react": "^5.0.3",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^7.3.2",
        "@mui/material": "^7.3.2",
        "@mui/x-data-grid": "^8.5.0",
        "@mui/x-tree-view": "^8.5.0",
        "antlr4ng-cli": "^2.0.0",
        "eslint": "^9.36.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.21",
        "postcss": "^8.4.49",
        "postcss-prefixwrap": "^1.50.0",
        "prettier": "^3.6.2",
        "react": "^19.1.4",
        "react-dom": "^19.1.4",
        "typescript": "^5.9.2",
        "vite": "^7.1.7",
        "monaco-editor": "^0.55.1",
        "@monaco-editor/react": "^4.7.0"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0",
        "react-is": "^18.0.0 || ^19.0.0",
        "monaco-editor": "^0.52.0",
        "@monaco-editor/react": "^4.6.0",
        "@emotion/react": "^11.0.0",
        "@emotion/styled": "^11.0.0",
        "@mui/icons-material": "^7.0.0",
        "@mui/material": "^7.0.0",
        "@mui/x-data-grid": "^8.0.0",
        "@mui/x-tree-view": "^8.0.0"
    }
}
